NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=healthcare_mvp
SESSION_SECRET=replace-with-a-random-32-byte-or-longer-secret

# Used only by the optional local demo seed script; set a unique local value.
DEMO_PASSWORD=

# Optional: creates an administrator account for doctor verification.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=99999999

# Optional deployment integrations.
CORS_ORIGINS=
TRUST_PROXY=1
OVERDUE_AFTER_MINUTES=30
MISSED_AFTER_MINUTES=240
MISSED_DOSE_THRESHOLD=3
MISSED_DOSE_WINDOW_DAYS=7
DOSE_HISTORY_DAYS=14
HTTP_USER_AGENT=healthcare-mvp-hackathon/1.0 (demo app)
OPENFDA_API_KEY=
